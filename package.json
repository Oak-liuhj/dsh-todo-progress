{
  "name": "dsh-todo-progress",
  "version": "1.2.0",
  "type": "module",
  "description": "会话任务进度右侧栏 tab：todos 投影只读适配层（契约 v0.2，设计基线 v1.0）",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "scripts/",
    "docs/images/",
    "docs/本地验收记录-1.2.0-2026-11-06.md",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs && node test/selfcheck-load.mjs"
  },
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "verifiedDsh": "0.2.1-rc.5",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dsBot": {
    "min": "0.2.6",
    "verified": "0.2.7",
    "aliases": [
      "dsh-task-panel"
    ]
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
